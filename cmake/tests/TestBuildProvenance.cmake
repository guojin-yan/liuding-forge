cmake_minimum_required(VERSION 3.18)

if(NOT JYPPX_SOURCE_DIR OR NOT JYPPX_LIUDING_TEST_ROOT OR NOT JYPPX_CMAKE_GENERATOR)
    message(FATAL_ERROR "Build provenance lifecycle is missing required paths")
endif()
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef nonce)
set(root "${JYPPX_LIUDING_TEST_ROOT}/case-${nonce}")
set(build "${root}/build")
file(MAKE_DIRECTORY "${root}")
set(generator_args -G "${JYPPX_CMAKE_GENERATOR}")
if(JYPPX_CMAKE_GENERATOR_PLATFORM)
    list(APPEND generator_args -A "${JYPPX_CMAKE_GENERATOR_PLATFORM}")
endif()
if(JYPPX_CMAKE_GENERATOR_TOOLSET)
    list(APPEND generator_args -T "${JYPPX_CMAKE_GENERATOR_TOOLSET}")
endif()
set(compiler_args)
if(JYPPX_CXX_COMPILER)
    list(APPEND compiler_args "-DCMAKE_CXX_COMPILER=${JYPPX_CXX_COMPILER}")
endif()
string(REPEAT a 40 commit_a)
string(REPEAT b 40 commit_b)
string(REPEAT c 64 lock_a)
string(REPEAT d 64 lock_b)

function(invoke name expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 90)
    file(WRITE "${root}/${name}.log" "${stdout}${stderr}")
    if(expected STREQUAL "success" AND NOT result EQUAL 0)
        message(FATAL_ERROR "${name} failed: ${stdout}${stderr}")
    elseif(expected STREQUAL "failure" AND result EQUAL 0)
        message(FATAL_ERROR "${name} unexpectedly succeeded")
    endif()
endfunction()

function(configure_fixture name commit lock)
    invoke("${name}" success "${CMAKE_COMMAND}"
        -S "${JYPPX_SOURCE_DIR}/tests/cmake/build_provenance" -B "${build}"
        ${generator_args} ${compiler_args} -DCMAKE_BUILD_TYPE=Release
        "-DJYPPX_PROVENANCE_MODULE=${JYPPX_SOURCE_DIR}/cmake/BuildProvenance.cmake"
        "-DTEST_BUILD_COMMIT=${commit}" "-DTEST_BUILD_LOCK=${lock}")
endfunction()

function(check_install name config commit lock)
    invoke("${name}" success "${CMAKE_COMMAND}" --install "${build}"
        --config "${config}" --prefix "${root}/${name}")
    file(READ "${root}/${name}/share/jyppx/build-provenance.json" metadata)
    foreach(pair IN ITEMS "git_commit;${commit}" "dependency_lock_sha256;${lock}" "configuration;${config}")
        list(GET pair 0 key)
        list(GET pair 1 expected)
        if(NOT metadata MATCHES "\"${key}\"[ \t\r\n]*:[ \t\r\n]*\"${expected}\"")
            message(FATAL_ERROR "${name}: installed ${key} differs from built identity")
        endif()
    endforeach()
endfunction()

function(check_probe name config commit lock)
    set(probe_name provenance_probe)
    if(WIN32)
        string(APPEND probe_name ".exe")
    endif()
    set(executable "${build}/${probe_name}")
    if(is_multi)
        set(executable "${build}/${config}/${probe_name}")
    endif()
    execute_process(COMMAND "${executable}" RESULT_VARIABLE result
        OUTPUT_VARIABLE actual ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 10)
    file(WRITE "${root}/${name}.log" "${actual}\n${error}")
    if(NOT result EQUAL 0 OR NOT actual STREQUAL "${commit};${lock}")
        message(FATAL_ERROR "${name}: native library differs from expected built identity")
    endif()
endfunction()

configure_fixture(configure-a "${commit_a}" "${lock_a}")
file(READ "${build}/multi-config.txt" is_multi)
invoke(before-build failure "${CMAKE_COMMAND}" --install "${build}"
    --config Release --prefix "${root}/before-build")
file(READ "${root}/before-build.log" missing_log)
if(NOT missing_log MATCHES "build-provenance[.]json")
    message(FATAL_ERROR "Unbuilt install did not reject missing built provenance")
endif()
invoke(build-a success "${CMAKE_COMMAND}" --build "${build}" --config Release --parallel 1)
check_install(install-a Release "${commit_a}" "${lock_a}")
check_probe(probe-a Release "${commit_a}" "${lock_a}")
configure_fixture(configure-b "${commit_b}" "${lock_b}")
check_install(unbuilt-b-retains-a Release "${commit_a}" "${lock_a}")
check_probe(probe-unbuilt-b-retains-a Release "${commit_a}" "${lock_a}")
if(is_multi)
    invoke(build-debug-b success "${CMAKE_COMMAND}" --build "${build}" --config Debug --parallel 1)
    check_install(debug-b Debug "${commit_b}" "${lock_b}")
    check_probe(probe-debug-b Debug "${commit_b}" "${lock_b}")
    check_install(release-after-debug-b Release "${commit_a}" "${lock_a}")
    check_probe(probe-release-after-debug-b Release "${commit_a}" "${lock_a}")
endif()
invoke(build-release-b success "${CMAKE_COMMAND}" --build "${build}" --config Release --parallel 1)
check_install(release-b Release "${commit_b}" "${lock_b}")
check_probe(probe-release-b Release "${commit_b}" "${lock_b}")
file(REMOVE "${build}/build-provenance/built/Release/build-provenance.json")
configure_fixture(configure-missing-stamp "${commit_b}" "${lock_b}")
invoke(missing-stamp failure "${CMAKE_COMMAND}" --install "${build}"
    --config Release --prefix "${root}/missing-stamp")
file(READ "${root}/missing-stamp.log" missing_stamp_log)
if(NOT missing_stamp_log MATCHES "build-provenance[.]json")
    message(FATAL_ERROR "Reconfiguration did not preserve missing built-stamp rejection")
endif()
file(WRITE "${root}/passed.txt" "Source/lock remained bound to the actually built native library.\nMulti-config checked: ${is_multi}\n")
message(STATUS "Build provenance lifecycle passed; multi-config=${is_multi}; evidence=${root}")
