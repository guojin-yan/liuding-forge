# Private static backend: no OpenSSL headers or ambient SDK lookup in consumers.
get_filename_component(_jyppx_crypto_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_jyppx_crypto_archive
    "${_jyppx_crypto_prefix}/lib/jyppx/openssl-3.5.9/@JYPPX_BUNDLE_CRYPTO_FILENAME@")
if(NOT EXISTS "${_jyppx_crypto_archive}")
    message(FATAL_ERROR "Installed bundle signing Crypto archive is missing")
endif()
file(SHA256 "${_jyppx_crypto_archive}" _jyppx_crypto_sha256)
if(NOT _jyppx_crypto_sha256 STREQUAL "@JYPPX_BUNDLE_CRYPTO_SHA256@")
    message(FATAL_ERROR "Installed bundle signing Crypto archive differs from this package's backend")
endif()
if(NOT TARGET jyppx::liuding::_bundle_crypto)
    add_library(jyppx::liuding::_bundle_crypto STATIC IMPORTED)
    set_target_properties(jyppx::liuding::_bundle_crypto PROPERTIES
        IMPORTED_LOCATION "${_jyppx_crypto_archive}")
    if(WIN32)
        set_property(TARGET jyppx::liuding::_bundle_crypto PROPERTY
            INTERFACE_LINK_LIBRARIES "ws2_32;crypt32;advapi32;user32;gdi32;bcrypt")
    else()
        set_property(TARGET jyppx::liuding::_bundle_crypto PROPERTY
            INTERFACE_LINK_LIBRARIES "Threads::Threads;${CMAKE_DL_LIBS}")
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        # Preserve the private backend's ELF symbol isolation after relocation;
        # consumers may also load a system TLS library with its own Crypto ABI.
        set_property(TARGET jyppx::liuding::_bundle_crypto APPEND PROPERTY
            INTERFACE_LINK_OPTIONS
            "LINKER:--exclude-libs,@JYPPX_BUNDLE_CRYPTO_FILENAME@")
    endif()
else()
    get_target_property(_jyppx_existing_crypto jyppx::liuding::_bundle_crypto IMPORTED_LOCATION)
    if(NOT _jyppx_existing_crypto STREQUAL _jyppx_crypto_archive)
        message(FATAL_ERROR "Conflicting installed bundle signing backends")
    endif()
endif()
unset(_jyppx_crypto_prefix)
unset(_jyppx_crypto_archive)
unset(_jyppx_crypto_sha256)
unset(_jyppx_existing_crypto)
