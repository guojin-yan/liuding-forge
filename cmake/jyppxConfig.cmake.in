@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Torch REQUIRED)
if(@JYPPX_LIUDING_BUILD_EXPERIMENT@ OR @JYPPX_LIUDING_BUILD_SERVING@ OR @JYPPX_LIUDING_BUILD_BUNDLE_SIGNING@)
    find_dependency(Threads REQUIRED)
endif()

if(@JYPPX_LIUDING_BUILD_ONNX_RUNTIME@)
    include("${CMAKE_CURRENT_LIST_DIR}/jyppxOnnxRuntime.cmake")
endif()
if(@JYPPX_LIUDING_BUILD_BUNDLE_SIGNING@)
    include("${CMAKE_CURRENT_LIST_DIR}/jyppxBundleCrypto.cmake")
endif()
if(@JYPPX_LIUDING_BUILD_TELEMETRY_HTTP@ AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    # Explicit SDK/offline consumers never discover an unused network SDK.
    if(NOT jyppx_FIND_COMPONENTS OR "telemetry_http" IN_LIST jyppx_FIND_COMPONENTS
       OR "all" IN_LIST jyppx_FIND_COMPONENTS)
        include("${CMAKE_CURRENT_LIST_DIR}/jyppxTelemetryHttpDependency.cmake")
        jyppx_require_telemetry_http_curl()
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/jyppxTargets.cmake")

set(_jyppx_known_components
    bundle_signing
    foundation
    core
    interop
    data
    data_image
    vision_render
    nn
    onnx_export
    onnx_runtime
    onnx_serving
    training
    optim
    experiment
    telemetry_http
    telemetry_native
    models
    quantization
    serving
    all
    sdk
)
set(jyppx_AVAILABLE_COMPONENTS "@JYPPX_ENABLED_COMPONENTS@")

foreach(_jyppx_component IN LISTS _jyppx_known_components)
    if(TARGET jyppx::liuding::${_jyppx_component})
        set(jyppx_${_jyppx_component}_FOUND TRUE)
    else()
        set(jyppx_${_jyppx_component}_FOUND FALSE)
    endif()
endforeach()

foreach(_jyppx_component IN LISTS jyppx_FIND_COMPONENTS)
    if(NOT _jyppx_component IN_LIST _jyppx_known_components)
        set(jyppx_${_jyppx_component}_FOUND FALSE)
        set(jyppx_NOT_FOUND_MESSAGE
            "Unsupported jyppx component: ${_jyppx_component}")
    elseif(NOT jyppx_${_jyppx_component}_FOUND)
        set(jyppx_NOT_FOUND_MESSAGE
            "Requested jyppx component was disabled at configure time: ${_jyppx_component}")
    endif()
endforeach()

foreach(_jyppx_exported_target IN ITEMS
        jyppx::liuding::foundation jyppx::liuding::core jyppx::liuding::interop jyppx::liuding::data jyppx::liuding::data_image jyppx::liuding::nn
        jyppx::liuding::training jyppx::liuding::optim jyppx::liuding::experiment jyppx::liuding::telemetry_native jyppx::liuding::telemetry_http
        jyppx::liuding::models jyppx::liuding::onnx_export jyppx::liuding::onnx_runtime
        jyppx::liuding::onnx_serving jyppx::liuding::bundle_signing
        jyppx::liuding::quantization jyppx::liuding::serving
        jyppx::liuding::vision_render jyppx::liuding::all jyppx::liuding::sdk)
    if(TARGET ${_jyppx_exported_target})
        set_property(TARGET ${_jyppx_exported_target} APPEND
            PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${TORCH_INCLUDE_DIRS}")
    endif()
endforeach()

check_required_components(jyppx)

unset(_jyppx_component)
unset(_jyppx_exported_target)
unset(_jyppx_known_components)
