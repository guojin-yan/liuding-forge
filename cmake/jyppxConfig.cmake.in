@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Torch REQUIRED)
if(@JYPPX_BUILD_EXPERIMENT@ OR @JYPPX_BUILD_SERVING@)
    find_dependency(Threads REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/jyppxTargets.cmake")

set(_jyppx_known_components
    foundation
    core
    interop
    data
    data_image
    nn
    training
    optim
    experiment
    models
    quantization
    serving
    all
    sdk
)
set(jyppx_AVAILABLE_COMPONENTS "@JYPPX_ENABLED_COMPONENTS@")

foreach(_jyppx_component IN LISTS _jyppx_known_components)
    if(TARGET jyppx::${_jyppx_component})
        set(jyppx_${_jyppx_component}_FOUND TRUE)
    else()
        set(jyppx_${_jyppx_component}_FOUND FALSE)
    endif()
endforeach()

foreach(_jyppx_component IN LISTS jyppx_FIND_COMPONENTS)
    if(NOT _jyppx_component IN_LIST _jyppx_known_components)
        set(jyppx_${_jyppx_component}_FOUND FALSE)
        set(jyppx_NOT_FOUND_MESSAGE
            "Unsupported jyppx component: ${_jyppx_component}")
    elseif(NOT jyppx_${_jyppx_component}_FOUND)
        set(jyppx_NOT_FOUND_MESSAGE
            "Requested jyppx component was disabled at configure time: ${_jyppx_component}")
    endif()
endforeach()

foreach(_jyppx_exported_target IN ITEMS
        jyppx::foundation jyppx::core jyppx::interop jyppx::data jyppx::data_image jyppx::nn
        jyppx::training jyppx::optim jyppx::experiment
        jyppx::models jyppx::quantization jyppx::serving jyppx::all jyppx::sdk)
    if(TARGET ${_jyppx_exported_target})
        set_property(TARGET ${_jyppx_exported_target} APPEND
            PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${TORCH_INCLUDE_DIRS}")
    endif()
endforeach()

check_required_components(jyppx)

unset(_jyppx_component)
unset(_jyppx_exported_target)
unset(_jyppx_known_components)
