cmake_minimum_required(VERSION 3.18)
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()

foreach(required_variable IN ITEMS
        JYPPX_ROCM_TORCH_HIP_DLL
        JYPPX_ROCM_HIP_RUNTIME_DLL
        JYPPX_ROCM_TORCH_RUNTIME_DIR
        JYPPX_ROCM_HIP_RUNTIME_DIR
        JYPPX_ROCM_WINDOWS_RUNTIME_MANIFEST
        CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND)
    if(NOT DEFINED ${required_variable} OR "${${required_variable}}" STREQUAL "")
        message(FATAL_ERROR "Missing required Windows HIP runtime scan input: ${required_variable}")
    endif()
endforeach()

foreach(required_file IN ITEMS
        "${JYPPX_ROCM_TORCH_HIP_DLL}"
        "${JYPPX_ROCM_HIP_RUNTIME_DLL}")
    if(NOT EXISTS "${required_file}" OR IS_DIRECTORY "${required_file}")
        message(FATAL_ERROR "Windows HIP runtime scan input is missing: ${required_file}")
    endif()
endforeach()
if(NOT EXISTS "${CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND}")
    message(FATAL_ERROR "Windows HIP runtime scan tool is missing")
endif()

get_filename_component(torch_runtime_dir "${JYPPX_ROCM_TORCH_RUNTIME_DIR}" REALPATH)
get_filename_component(hip_runtime_dir "${JYPPX_ROCM_HIP_RUNTIME_DIR}" REALPATH)
get_filename_component(hip_runtime_dll "${JYPPX_ROCM_HIP_RUNTIME_DLL}" REALPATH)
file(TO_CMAKE_PATH "${torch_runtime_dir}" torch_runtime_dir)
file(TO_CMAKE_PATH "${hip_runtime_dir}" hip_runtime_dir)
file(TO_CMAKE_PATH "${hip_runtime_dll}" hip_runtime_dll)
set(torch_runtime_prefix "${torch_runtime_dir}/")
set(hip_runtime_prefix "${hip_runtime_dir}/")
if(WIN32)
    string(TOLOWER "${torch_runtime_prefix}" torch_runtime_prefix)
    string(TOLOWER "${hip_runtime_prefix}" hip_runtime_prefix)
    string(TOLOWER "${hip_runtime_dll}" hip_runtime_dll)
endif()

set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND}")
# MIOpen loads device-specific CK kernels at runtime, so they are absent from
# the PE import table. Keep the selected SDK's optional modules and scan their
# own imports too; applications can otherwise silently fall back to other kernels.
file(GLOB miopen_device_libraries "${hip_runtime_dir}/MIOpenCK*.dll")
file(GET_RUNTIME_DEPENDENCIES
    LIBRARIES "${JYPPX_ROCM_TORCH_HIP_DLL}" "${JYPPX_ROCM_HIP_RUNTIME_DLL}"
              ${miopen_device_libraries}
    DIRECTORIES "${JYPPX_ROCM_TORCH_RUNTIME_DIR}" "${JYPPX_ROCM_HIP_RUNTIME_DIR}"
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    RESOLVED_DEPENDENCIES_VAR resolved_dependencies
    UNRESOLVED_DEPENDENCIES_VAR unresolved_dependencies)
list(APPEND resolved_dependencies ${miopen_device_libraries})
list(REMOVE_DUPLICATES resolved_dependencies)

if(unresolved_dependencies)
    list(SORT unresolved_dependencies)
    list(JOIN unresolved_dependencies ", " unresolved_text)
    message(FATAL_ERROR "Windows HIP runtime import closure has unresolved DLLs: ${unresolved_text}")
endif()

set(system_root "$ENV{SystemRoot}")
if(NOT system_root)
    set(system_root "$ENV{WINDIR}")
endif()
if(system_root)
    get_filename_component(system_root "${system_root}" REALPATH)
    file(TO_CMAKE_PATH "${system_root}" system_root)
    set(system_root_prefix "${system_root}/")
    string(TOLOWER "${system_root_prefix}" system_root_prefix)
endif()

set(hip_runtime_dlls)
set(runtime_dll_lower_names)
foreach(resolved_dependency IN LISTS resolved_dependencies)
    get_filename_component(resolved_dependency "${resolved_dependency}" REALPATH)
    file(TO_CMAKE_PATH "${resolved_dependency}" resolved_dependency)
    set(dependency_comparison "${resolved_dependency}")
    if(WIN32)
        string(TOLOWER "${dependency_comparison}" dependency_comparison)
    endif()
    string(FIND "${dependency_comparison}" "${hip_runtime_prefix}" hip_prefix_position)
    if(hip_prefix_position EQUAL 0)
        get_filename_component(runtime_dll_name "${resolved_dependency}" NAME)
        string(TOLOWER "${runtime_dll_name}" runtime_dll_lower_name)
        if(runtime_dll_lower_name IN_LIST runtime_dll_lower_names)
            message(FATAL_ERROR "Duplicate Windows HIP runtime DLL name: ${runtime_dll_name}")
        endif()
        list(APPEND runtime_dll_lower_names "${runtime_dll_lower_name}")
        list(APPEND hip_runtime_dlls "${resolved_dependency}")
        continue()
    endif()
    string(FIND "${dependency_comparison}" "${torch_runtime_prefix}" torch_prefix_position)
    if(torch_prefix_position EQUAL 0)
        continue()
    endif()
    if(DEFINED system_root_prefix AND NOT "${system_root_prefix}" STREQUAL "")
        string(FIND "${dependency_comparison}" "${system_root_prefix}" system_prefix_position)
        if(system_prefix_position EQUAL 0)
            continue()
        endif()
    endif()
    message(FATAL_ERROR
        "Windows HIP runtime dependency resolved outside the selected LibTorch/HIP SDKs and Windows directory: ${resolved_dependency}")
endforeach()

if(NOT hip_runtime_dlls)
    message(FATAL_ERROR "Windows HIP runtime import closure contains no SDK DLLs")
endif()
set(runtime_dll_found FALSE)
foreach(runtime_dll IN LISTS hip_runtime_dlls)
    set(runtime_dll_comparison "${runtime_dll}")
    if(WIN32)
        string(TOLOWER "${runtime_dll_comparison}" runtime_dll_comparison)
    endif()
    if("${runtime_dll_comparison}" STREQUAL "${hip_runtime_dll}")
        set(runtime_dll_found TRUE)
    endif()
endforeach()
if(NOT runtime_dll_found)
    message(FATAL_ERROR "Windows HIP runtime DLL is absent from its own import closure")
endif()

list(REMOVE_DUPLICATES hip_runtime_dlls)
list(SORT hip_runtime_dlls)
get_filename_component(manifest_directory "${JYPPX_ROCM_WINDOWS_RUNTIME_MANIFEST}" DIRECTORY)
file(MAKE_DIRECTORY "${manifest_directory}")
set(manifest_content)
foreach(runtime_dll IN LISTS hip_runtime_dlls)
    string(APPEND manifest_content "${runtime_dll}\n")
endforeach()
set(manifest_changed TRUE)
if(EXISTS "${JYPPX_ROCM_WINDOWS_RUNTIME_MANIFEST}")
    file(READ "${JYPPX_ROCM_WINDOWS_RUNTIME_MANIFEST}" previous_manifest_content)
    if("${previous_manifest_content}" STREQUAL "${manifest_content}")
        set(manifest_changed FALSE)
    endif()
endif()
if(manifest_changed)
    file(WRITE "${JYPPX_ROCM_WINDOWS_RUNTIME_MANIFEST}" "${manifest_content}")
endif()
