# Build-tree dependencies are immutable; hard links avoid repeated SDK copies.
# The ownership index covers only files staged here, not other runtime targets.
cmake_minimum_required(VERSION 3.18)
if(NOT IS_ABSOLUTE "${JYPPX_RUNTIME_SOURCE_DIR}" OR
   NOT IS_ABSOLUTE "${JYPPX_RUNTIME_OUTPUT_DIR}")
    message(FATAL_ERROR "Runtime staging requires absolute directories")
endif()
if(NOT IS_DIRECTORY "${JYPPX_RUNTIME_SOURCE_DIR}")
    message(FATAL_ERROR "Runtime staging source directory is missing")
endif()
get_filename_component(runtime_source_root "${JYPPX_RUNTIME_SOURCE_DIR}" REALPATH)
get_filename_component(runtime_output_root "${JYPPX_RUNTIME_OUTPUT_DIR}" REALPATH)
file(TO_CMAKE_PATH "${runtime_source_root}" runtime_source_root)
file(TO_CMAKE_PATH "${runtime_output_root}" runtime_output_root)
set(runtime_source_comparison "${runtime_source_root}/")
set(runtime_output_comparison "${runtime_output_root}/")
if(WIN32)
    string(TOLOWER "${runtime_source_comparison}" runtime_source_comparison)
    string(TOLOWER "${runtime_output_comparison}" runtime_output_comparison)
endif()
string(FIND "${runtime_source_comparison}" "${runtime_output_comparison}" runtime_source_overlap)
string(FIND "${runtime_output_comparison}" "${runtime_source_comparison}" runtime_output_overlap)
if(runtime_source_overlap EQUAL 0 OR runtime_output_overlap EQUAL 0)
    message(FATAL_ERROR "Runtime source and output directories must not overlap")
endif()

if(JYPPX_RUNTIME_KPACK_ONLY)
    file(GLOB runtime_files "${runtime_source_root}/*.kpack")
    set(runtime_name_pattern "[A-Za-z0-9][A-Za-z0-9_.+-]*[.]kpack")
    set(runtime_inventory_name "liuding-forge-torch-kpack")
    set(runtime_scope "staged-torch-kpacks")
    # Sibling executables can share the parent .kpack directory. Serialize its
    # ownership updates independently from their DLL staging directories.
    if(IS_SYMLINK "${runtime_output_root}")
        message(FATAL_ERROR "Device archive destination must not be a symlink")
    endif()
    file(MAKE_DIRECTORY "${runtime_output_root}")
    file(LOCK "${runtime_output_root}/liuding-forge-kpack.lock" GUARD PROCESS TIMEOUT 60)
else()
    file(GLOB runtime_files "${runtime_source_root}/*.dll")
    set(runtime_name_pattern "([A-Za-z0-9][A-Za-z0-9_.+-]*[.]dll|aotriton[.]images/[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*(/[A-Za-z0-9_+.-]+)?)")
    set(runtime_inventory_name "liuding-forge-torch-runtime")
    set(runtime_scope "staged-torch-dlls")
    set(runtime_extra_files)
    if(JYPPX_RUNTIME_EXTRA_DLL_LIST OR JYPPX_RUNTIME_EXTRA_DLL_SOURCE_DIR)
        if(NOT IS_ABSOLUTE "${JYPPX_RUNTIME_EXTRA_DLL_LIST}" OR
           NOT EXISTS "${JYPPX_RUNTIME_EXTRA_DLL_LIST}" OR
           NOT IS_ABSOLUTE "${JYPPX_RUNTIME_EXTRA_DLL_SOURCE_DIR}" OR
           NOT IS_DIRECTORY "${JYPPX_RUNTIME_EXTRA_DLL_SOURCE_DIR}")
            message(FATAL_ERROR "Additional runtime DLL staging requires an absolute manifest and source directory")
        endif()
        get_filename_component(runtime_extra_source_root
            "${JYPPX_RUNTIME_EXTRA_DLL_SOURCE_DIR}" REALPATH)
        file(TO_CMAKE_PATH "${runtime_extra_source_root}" runtime_extra_source_root)
        set(runtime_extra_source_comparison "${runtime_extra_source_root}/")
        if(WIN32)
            string(TOLOWER "${runtime_extra_source_comparison}" runtime_extra_source_comparison)
        endif()
        string(FIND "${runtime_extra_source_comparison}" "${runtime_output_comparison}"
            runtime_extra_source_overlap)
        string(FIND "${runtime_output_comparison}" "${runtime_extra_source_comparison}"
            runtime_extra_output_overlap)
        if(runtime_extra_source_overlap EQUAL 0 OR runtime_extra_output_overlap EQUAL 0)
            message(FATAL_ERROR "Additional runtime source and output directories must not overlap")
        endif()
        file(STRINGS "${JYPPX_RUNTIME_EXTRA_DLL_LIST}" runtime_extra_files)
        set(runtime_extra_canonical_files)
        foreach(runtime_extra_file IN LISTS runtime_extra_files)
            if(NOT IS_ABSOLUTE "${runtime_extra_file}" OR
               NOT EXISTS "${runtime_extra_file}" OR
               IS_DIRECTORY "${runtime_extra_file}" OR
               IS_SYMLINK "${runtime_extra_file}")
                message(FATAL_ERROR "Additional runtime source is not a regular DLL: ${runtime_extra_file}")
            endif()
            get_filename_component(runtime_extra_real "${runtime_extra_file}" REALPATH)
            file(TO_CMAKE_PATH "${runtime_extra_real}" runtime_extra_real)
            get_filename_component(runtime_extra_parent "${runtime_extra_real}" DIRECTORY)
            file(TO_CMAKE_PATH "${runtime_extra_parent}" runtime_extra_parent)
            set(runtime_extra_parent_comparison "${runtime_extra_parent}")
            set(runtime_extra_root_comparison "${runtime_extra_source_root}")
            if(WIN32)
                string(TOLOWER "${runtime_extra_parent_comparison}" runtime_extra_parent_comparison)
                string(TOLOWER "${runtime_extra_root_comparison}" runtime_extra_root_comparison)
            endif()
            if(NOT "${runtime_extra_parent_comparison}" STREQUAL "${runtime_extra_root_comparison}")
                message(FATAL_ERROR "Additional runtime DLL is outside its selected source directory")
            endif()
            list(APPEND runtime_files "${runtime_extra_real}")
            list(APPEND runtime_extra_canonical_files "${runtime_extra_real}")
        endforeach()
        set(runtime_extra_files "${runtime_extra_canonical_files}")
        if(runtime_extra_files)
            set(runtime_scope "staged-torch-runtime-sdk-closure")
        endif()
    endif()
endif()
if(NOT runtime_files)
    message(FATAL_ERROR "Runtime staging source has no DLLs")
endif()
# AOTriton resolves its images relative to its DLL. Preserve that subtree
# when staging ROCm LibTorch, including the archive signature files.
if(NOT JYPPX_RUNTIME_KPACK_ONLY)
    file(GLOB_RECURSE runtime_images LIST_DIRECTORIES FALSE
        "${runtime_source_root}/aotriton.images/*")
    list(APPEND runtime_files ${runtime_images})
    if(runtime_images)
        if(NOT runtime_extra_files)
            set(runtime_scope "staged-torch-runtime")
        endif()
    endif()
endif()
list(SORT runtime_files)
set(runtime_names)
set(runtime_lower_names)
function(jyppx_check_runtime_parents name)
    get_filename_component(parent "${runtime_output_root}/${name}" DIRECTORY)
    while(NOT parent STREQUAL runtime_output_root)
        if(IS_SYMLINK "${parent}")
            message(FATAL_ERROR "Runtime destination parent is a symlink: ${name}")
        endif()
        get_filename_component(parent "${parent}" DIRECTORY)
    endwhile()
endfunction()
foreach(runtime_source IN LISTS runtime_files)
    set(runtime_is_extra FALSE)
    if(DEFINED runtime_extra_source_root AND NOT "${runtime_extra_source_root}" STREQUAL "")
        get_filename_component(runtime_source_parent "${runtime_source}" DIRECTORY)
        get_filename_component(runtime_source_parent "${runtime_source_parent}" REALPATH)
        file(TO_CMAKE_PATH "${runtime_source_parent}" runtime_source_parent)
        set(runtime_source_parent_comparison "${runtime_source_parent}")
        set(runtime_extra_root_comparison "${runtime_extra_source_root}")
        if(WIN32)
            string(TOLOWER "${runtime_source_parent_comparison}" runtime_source_parent_comparison)
            string(TOLOWER "${runtime_extra_root_comparison}" runtime_extra_root_comparison)
        endif()
        if("${runtime_source_parent_comparison}" STREQUAL "${runtime_extra_root_comparison}")
            set(runtime_is_extra TRUE)
        endif()
    endif()
    if(runtime_is_extra)
        get_filename_component(runtime_name "${runtime_source}" NAME)
    else()
        file(RELATIVE_PATH runtime_name "${runtime_source_root}" "${runtime_source}")
    endif()
    if(NOT "${runtime_name}" MATCHES "^${runtime_name_pattern}$"
       OR "${runtime_name}" MATCHES "(^|/)[.][.]?(/|$)")
        message(FATAL_ERROR "Unsupported runtime DLL name: ${runtime_name}")
    endif()
    jyppx_check_runtime_parents("${runtime_name}")
    if(IS_SYMLINK "${runtime_source}" OR IS_DIRECTORY "${runtime_source}")
        message(FATAL_ERROR "Runtime source is not a regular DLL: ${runtime_name}")
    endif()
    string(TOLOWER "${runtime_name}" runtime_lower_name)
    if(runtime_lower_name IN_LIST runtime_lower_names)
        message(FATAL_ERROR "Duplicate runtime DLL name: ${runtime_name}")
    endif()
    if(IS_DIRECTORY "${runtime_output_root}/${runtime_name}" OR
       IS_SYMLINK "${runtime_output_root}/${runtime_name}")
        message(FATAL_ERROR "Runtime destination is not a regular DLL: ${runtime_name}")
    endif()
    get_filename_component(runtime_source_real "${runtime_source}" REALPATH)
    get_filename_component(runtime_destination_absolute
        "${runtime_output_root}/${runtime_name}" REALPATH)
    file(TO_CMAKE_PATH "${runtime_source_real}" runtime_source_real)
    file(TO_CMAKE_PATH "${runtime_destination_absolute}" runtime_destination_absolute)
    if(WIN32)
        string(TOLOWER "${runtime_source_real}" runtime_source_comparison)
        string(TOLOWER "${runtime_destination_absolute}" runtime_destination_comparison)
    else()
        set(runtime_source_comparison "${runtime_source_real}")
        set(runtime_destination_comparison "${runtime_destination_absolute}")
    endif()
    if("${runtime_source_comparison}" STREQUAL "${runtime_destination_comparison}")
        message(FATAL_ERROR "Runtime source and destination must be different files: ${runtime_name}")
    endif()
    list(APPEND runtime_names "${runtime_name}")
    list(APPEND runtime_lower_names "${runtime_lower_name}")
endforeach()

set(runtime_index "${runtime_output_root}/${runtime_inventory_name}.files")
set(runtime_report "${runtime_output_root}/${runtime_inventory_name}.json")
set(runtime_stale_names)
if(EXISTS "${runtime_index}")
    file(SIZE "${runtime_index}" runtime_index_size)
    if(runtime_index_size GREATER 1048576)
        message(FATAL_ERROR "Runtime ownership index exceeds 1 MiB")
    endif()
    file(STRINGS "${runtime_index}" runtime_previous)
    if(NOT runtime_previous)
        message(FATAL_ERROR "Runtime ownership index is empty")
    endif()
    list(POP_FRONT runtime_previous runtime_header)
    if(NOT runtime_header STREQUAL "liuding-forge-torch-runtime-v1")
        message(FATAL_ERROR "Unsupported runtime ownership index")
    endif()
    set(runtime_previous_names)
    foreach(runtime_record IN LISTS runtime_previous)
        if(NOT runtime_record MATCHES "^([0-9a-f]+) (${runtime_name_pattern})$")
            message(FATAL_ERROR "Invalid runtime ownership record")
        endif()
        set(runtime_previous_hash "${CMAKE_MATCH_1}")
        set(runtime_previous_name "${CMAKE_MATCH_2}")
        if(runtime_previous_name MATCHES "(^|/)[.][.]?(/|$)")
            message(FATAL_ERROR "Invalid runtime ownership path")
        endif()
        jyppx_check_runtime_parents("${runtime_previous_name}")
        string(LENGTH "${runtime_previous_hash}" runtime_hash_length)
        string(TOLOWER "${runtime_previous_name}" runtime_previous_lower_name)
        if(NOT runtime_hash_length EQUAL 64 OR
           runtime_previous_lower_name IN_LIST runtime_previous_names)
            message(FATAL_ERROR "Invalid or duplicate runtime ownership record")
        endif()
        list(APPEND runtime_previous_names "${runtime_previous_lower_name}")
        if(NOT runtime_previous_lower_name IN_LIST runtime_lower_names)
            set(runtime_stale "${runtime_output_root}/${runtime_previous_name}")
            if(IS_DIRECTORY "${runtime_stale}" OR IS_SYMLINK "${runtime_stale}")
                message(FATAL_ERROR "Old runtime file was replaced: ${runtime_previous_name}")
            endif()
            if(EXISTS "${runtime_stale}")
                file(SHA256 "${runtime_stale}" runtime_stale_hash)
                if(NOT runtime_stale_hash STREQUAL runtime_previous_hash)
                    message(FATAL_ERROR "Old runtime file was modified: ${runtime_previous_name}")
                endif()
                list(APPEND runtime_stale_names "${runtime_previous_name}")
            endif()
        endif()
    endforeach()
endif()

# Validate inputs and ownership before mutation. Publish after successful staging.
file(MAKE_DIRECTORY "${runtime_output_root}")
set(runtime_index_content "liuding-forge-torch-runtime-v1\n")
set(runtime_rows)
set(runtime_source_index 0)
foreach(runtime_source IN LISTS runtime_files)
    list(GET runtime_names "${runtime_source_index}" runtime_name)
    math(EXPR runtime_source_index "${runtime_source_index}+1")
    set(runtime_destination "${runtime_output_root}/${runtime_name}")
    get_filename_component(runtime_destination_parent "${runtime_destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${runtime_destination_parent}")
    set(runtime_same FALSE)
    if(EXISTS "${runtime_destination}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
            "${runtime_source}" "${runtime_destination}"
            RESULT_VARIABLE runtime_difference)
        if(runtime_difference EQUAL 0)
            set(runtime_same TRUE)
        endif()
    endif()
    if(NOT runtime_same)
        set(runtime_temporary "${runtime_destination}.liuding-forge-stage")
        file(REMOVE "${runtime_temporary}")
        file(CREATE_LINK "${runtime_source}" "${runtime_temporary}"
            RESULT runtime_result COPY_ON_ERROR)
        if(NOT runtime_result STREQUAL "0")
            message(FATAL_ERROR "Could not stage ${runtime_name}: ${runtime_result}")
        endif()
        file(RENAME "${runtime_temporary}" "${runtime_destination}")
    endif()
    file(SHA256 "${runtime_source}" runtime_source_hash)
    file(SHA256 "${runtime_destination}" runtime_destination_hash)
    if(NOT runtime_source_hash STREQUAL runtime_destination_hash)
        message(FATAL_ERROR "Staged runtime bytes differ: ${runtime_name}")
    endif()
    file(SIZE "${runtime_destination}" runtime_bytes)
    string(APPEND runtime_index_content "${runtime_source_hash} ${runtime_name}\n")
    list(APPEND runtime_rows
        "    {\"name\":\"${runtime_name}\",\"bytes\":${runtime_bytes},\"sha256\":\"${runtime_source_hash}\"}")
endforeach()
foreach(runtime_stale_name IN LISTS runtime_stale_names)
    file(REMOVE "${runtime_output_root}/${runtime_stale_name}")
endforeach()
list(JOIN runtime_rows ",\n" runtime_json_rows)
set(runtime_json "{\n  \"schema\":\"liuding.torch-runtime-staging/v1\",\n  \"scope\":\"${runtime_scope}\",\n  \"files\":[\n${runtime_json_rows}\n  ]\n}\n")
file(WRITE "${runtime_index}.new" "${runtime_index_content}")
file(WRITE "${runtime_report}.new" "${runtime_json}")
file(RENAME "${runtime_index}.new" "${runtime_index}")
file(RENAME "${runtime_report}.new" "${runtime_report}")

if(NOT JYPPX_RUNTIME_KPACK_ONLY AND EXISTS "${runtime_source_root}/torch_hip.dll"
   AND IS_DIRECTORY "${runtime_source_root}/../.kpack")
    # HIPK metadata in torch_hip.dll expects ../.kpack relative to that DLL.
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DJYPPX_RUNTIME_SOURCE_DIR=${runtime_source_root}/../.kpack"
        "-DJYPPX_RUNTIME_OUTPUT_DIR=${runtime_output_root}/../.kpack"
        -DJYPPX_RUNTIME_KPACK_ONLY=ON
        -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE runtime_kpack_result)
    if(NOT runtime_kpack_result EQUAL 0)
        message(FATAL_ERROR "Staging ROCm LibTorch device archives failed")
    endif()
endif()
