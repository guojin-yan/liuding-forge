# Build-tree dependencies are immutable; hard links avoid repeated SDK copies.
# The ownership index covers only files staged here, not other runtime targets.
cmake_minimum_required(VERSION 3.18)
if(NOT IS_ABSOLUTE "${JYPPX_RUNTIME_SOURCE_DIR}" OR
   NOT IS_ABSOLUTE "${JYPPX_RUNTIME_OUTPUT_DIR}")
    message(FATAL_ERROR "Runtime staging requires absolute directories")
endif()
if(NOT IS_DIRECTORY "${JYPPX_RUNTIME_SOURCE_DIR}")
    message(FATAL_ERROR "Runtime staging source directory is missing")
endif()
get_filename_component(runtime_source_root "${JYPPX_RUNTIME_SOURCE_DIR}" REALPATH)
get_filename_component(runtime_output_root "${JYPPX_RUNTIME_OUTPUT_DIR}" REALPATH)
file(TO_CMAKE_PATH "${runtime_source_root}" runtime_source_root)
file(TO_CMAKE_PATH "${runtime_output_root}" runtime_output_root)
set(runtime_source_comparison "${runtime_source_root}/")
set(runtime_output_comparison "${runtime_output_root}/")
if(WIN32)
    string(TOLOWER "${runtime_source_comparison}" runtime_source_comparison)
    string(TOLOWER "${runtime_output_comparison}" runtime_output_comparison)
endif()
string(FIND "${runtime_source_comparison}" "${runtime_output_comparison}" runtime_source_overlap)
string(FIND "${runtime_output_comparison}" "${runtime_source_comparison}" runtime_output_overlap)
if(runtime_source_overlap EQUAL 0 OR runtime_output_overlap EQUAL 0)
    message(FATAL_ERROR "Runtime source and output directories must not overlap")
endif()

file(GLOB runtime_files "${runtime_source_root}/*.dll")
list(SORT runtime_files)
if(NOT runtime_files)
    message(FATAL_ERROR "Runtime staging source has no DLLs")
endif()
set(runtime_names)
set(runtime_lower_names)
foreach(runtime_source IN LISTS runtime_files)
    get_filename_component(runtime_name "${runtime_source}" NAME)
    if(NOT runtime_name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+-]*[.]dll$")
        message(FATAL_ERROR "Unsupported runtime DLL name: ${runtime_name}")
    endif()
    if(IS_SYMLINK "${runtime_source}" OR IS_DIRECTORY "${runtime_source}")
        message(FATAL_ERROR "Runtime source is not a regular DLL: ${runtime_name}")
    endif()
    string(TOLOWER "${runtime_name}" runtime_lower_name)
    if(runtime_lower_name IN_LIST runtime_lower_names)
        message(FATAL_ERROR "Duplicate runtime DLL name: ${runtime_name}")
    endif()
    if(IS_DIRECTORY "${runtime_output_root}/${runtime_name}" OR
       IS_SYMLINK "${runtime_output_root}/${runtime_name}")
        message(FATAL_ERROR "Runtime destination is not a regular DLL: ${runtime_name}")
    endif()
    list(APPEND runtime_names "${runtime_name}")
    list(APPEND runtime_lower_names "${runtime_lower_name}")
endforeach()

set(runtime_index "${runtime_output_root}/liuding-forge-torch-runtime.files")
set(runtime_report "${runtime_output_root}/liuding-forge-torch-runtime.json")
set(runtime_stale_names)
if(EXISTS "${runtime_index}")
    file(SIZE "${runtime_index}" runtime_index_size)
    if(runtime_index_size GREATER 1048576)
        message(FATAL_ERROR "Runtime ownership index exceeds 1 MiB")
    endif()
    file(STRINGS "${runtime_index}" runtime_previous)
    if(NOT runtime_previous)
        message(FATAL_ERROR "Runtime ownership index is empty")
    endif()
    list(POP_FRONT runtime_previous runtime_header)
    if(NOT runtime_header STREQUAL "liuding-forge-torch-runtime-v1")
        message(FATAL_ERROR "Unsupported runtime ownership index")
    endif()
    set(runtime_previous_names)
    foreach(runtime_record IN LISTS runtime_previous)
        if(NOT runtime_record MATCHES "^([0-9a-f]+) ([A-Za-z0-9][A-Za-z0-9_.+-]*[.]dll)$")
            message(FATAL_ERROR "Invalid runtime ownership record")
        endif()
        set(runtime_previous_hash "${CMAKE_MATCH_1}")
        set(runtime_previous_name "${CMAKE_MATCH_2}")
        string(LENGTH "${runtime_previous_hash}" runtime_hash_length)
        string(TOLOWER "${runtime_previous_name}" runtime_previous_lower_name)
        if(NOT runtime_hash_length EQUAL 64 OR
           runtime_previous_lower_name IN_LIST runtime_previous_names)
            message(FATAL_ERROR "Invalid or duplicate runtime ownership record")
        endif()
        list(APPEND runtime_previous_names "${runtime_previous_lower_name}")
        if(NOT runtime_previous_lower_name IN_LIST runtime_lower_names)
            set(runtime_stale "${runtime_output_root}/${runtime_previous_name}")
            if(IS_DIRECTORY "${runtime_stale}" OR IS_SYMLINK "${runtime_stale}")
                message(FATAL_ERROR "Old runtime file was replaced: ${runtime_previous_name}")
            endif()
            if(EXISTS "${runtime_stale}")
                file(SHA256 "${runtime_stale}" runtime_stale_hash)
                if(NOT runtime_stale_hash STREQUAL runtime_previous_hash)
                    message(FATAL_ERROR "Old runtime file was modified: ${runtime_previous_name}")
                endif()
                list(APPEND runtime_stale_names "${runtime_previous_name}")
            endif()
        endif()
    endforeach()
endif()

# Validate inputs and ownership before mutation. Publish after successful staging.
file(MAKE_DIRECTORY "${runtime_output_root}")
set(runtime_index_content "liuding-forge-torch-runtime-v1\n")
set(runtime_rows)
foreach(runtime_source IN LISTS runtime_files)
    get_filename_component(runtime_name "${runtime_source}" NAME)
    set(runtime_destination "${runtime_output_root}/${runtime_name}")
    set(runtime_same FALSE)
    if(EXISTS "${runtime_destination}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
            "${runtime_source}" "${runtime_destination}"
            RESULT_VARIABLE runtime_difference)
        if(runtime_difference EQUAL 0)
            set(runtime_same TRUE)
        endif()
    endif()
    if(NOT runtime_same)
        set(runtime_temporary "${runtime_destination}.liuding-forge-stage")
        file(REMOVE "${runtime_temporary}")
        file(CREATE_LINK "${runtime_source}" "${runtime_temporary}"
            RESULT runtime_result COPY_ON_ERROR)
        if(NOT runtime_result STREQUAL "0")
            message(FATAL_ERROR "Could not stage ${runtime_name}: ${runtime_result}")
        endif()
        file(RENAME "${runtime_temporary}" "${runtime_destination}")
    endif()
    file(SHA256 "${runtime_source}" runtime_source_hash)
    file(SHA256 "${runtime_destination}" runtime_destination_hash)
    if(NOT runtime_source_hash STREQUAL runtime_destination_hash)
        message(FATAL_ERROR "Staged runtime bytes differ: ${runtime_name}")
    endif()
    file(SIZE "${runtime_destination}" runtime_bytes)
    string(APPEND runtime_index_content "${runtime_source_hash} ${runtime_name}\n")
    list(APPEND runtime_rows
        "    {\"name\":\"${runtime_name}\",\"bytes\":${runtime_bytes},\"sha256\":\"${runtime_source_hash}\"}")
endforeach()
foreach(runtime_stale_name IN LISTS runtime_stale_names)
    file(REMOVE "${runtime_output_root}/${runtime_stale_name}")
endforeach()
list(JOIN runtime_rows ",\n" runtime_json_rows)
set(runtime_json "{\n  \"schema\":\"liuding.torch-runtime-staging/v1\",\n  \"scope\":\"staged-torch-dlls\",\n  \"files\":[\n${runtime_json_rows}\n  ]\n}\n")
file(WRITE "${runtime_index}.new" "${runtime_index_content}")
file(WRITE "${runtime_report}.new" "${runtime_json}")
file(RENAME "${runtime_index}.new" "${runtime_index}")
file(RENAME "${runtime_report}.new" "${runtime_report}")
