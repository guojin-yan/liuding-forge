# Shared by the build and installed consumer; no SDK is copied or downloaded.
function(jyppx_require_migraphx_runtime)
    if(TARGET jyppx_external_migraphx_c AND TARGET jyppx_external_migraphx_hip)
        return()
    endif()
    set(JYPPX_LIUDING_MIGRAPHX_ROOT "" CACHE PATH "Explicit external native MIGraphX 2.18.0 SDK")
    set(JYPPX_LIUDING_MIGRAPHX_HIP_ROOT "" CACHE PATH "Explicit external HIP SDK from ROCm 10.1.0")
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR
       NOT (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux") OR
       NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
        message(FATAL_ERROR "MIGraphX runtime requires Windows/Linux x64")
    endif()
    foreach(variable IN ITEMS JYPPX_LIUDING_MIGRAPHX_ROOT JYPPX_LIUDING_MIGRAPHX_HIP_ROOT)
        if(NOT IS_ABSOLUTE "${${variable}}" OR NOT IS_DIRECTORY "${${variable}}")
            message(FATAL_ERROR "MIGraphX runtime requires explicit existing ${variable}")
        endif()
    endforeach()
    get_filename_component(mgx "${JYPPX_LIUDING_MIGRAPHX_ROOT}" REALPATH)
    get_filename_component(hip "${JYPPX_LIUDING_MIGRAPHX_HIP_ROOT}" REALPATH)
    foreach(file IN ITEMS "${mgx}/include/migraphx/migraphx.h" "${mgx}/include/migraphx/version.h"
            "${hip}/include/hip/hip_runtime_api.h" "${hip}/include/rocm-core/rocm_version.h")
        if(NOT EXISTS "${file}")
            message(FATAL_ERROR "Incomplete external MIGraphX/HIP SDK: ${file}")
        endif()
    endforeach()
    file(STRINGS "${mgx}/include/migraphx/version.h" version
        REGEX "^#define MIGRAPHX_VERSION_(MAJOR|MINOR|PATCH) ")
    foreach(pair IN ITEMS "MAJOR=2" "MINOR=18" "PATCH=0")
        string(REPLACE "=" ";" values "${pair}")
        list(GET values 0 part)
        list(GET values 1 expected)
        if(NOT "${version}" MATCHES "MIGRAPHX_VERSION_${part} +${expected}(;|$)")
            message(FATAL_ERROR "MIGraphX runtime requires exactly MIGraphX 2.18.0")
        endif()
    endforeach()
    file(STRINGS "${hip}/include/rocm-core/rocm_version.h" rocm_version
        REGEX "^#define ROCM_VERSION_(MAJOR|MINOR|PATCH) ")
    foreach(pair IN ITEMS "MAJOR=10" "MINOR=1" "PATCH=0")
        string(REPLACE "=" ";" values "${pair}")
        list(GET values 0 part)
        list(GET values 1 expected)
        if(NOT "${rocm_version}" MATCHES "ROCM_VERSION_${part} +${expected}(;|$)")
            message(FATAL_ERROR "MIGraphX runtime requires HIP from exactly ROCm 10.1.0")
        endif()
    endforeach()
    if(WIN32)
        set(mgx_runtime "${mgx}/bin/migraphx_c.dll")
        set(mgx_library "${mgx}/lib/migraphx_c.lib")
        set(hip_runtime "${hip}/bin/amdhip64_7.dll")
        set(hip_library "${hip}/lib/amdhip64.lib")
    else()
        set(mgx_runtime "${mgx}/lib/libmigraphx_c.so")
        set(mgx_library "${mgx_runtime}")
        set(hip_runtime "${hip}/lib/libamdhip64.so")
        set(hip_library "${hip_runtime}")
    endif()
    foreach(file IN ITEMS "${mgx_runtime}" "${mgx_library}" "${hip_runtime}" "${hip_library}")
        if(NOT EXISTS "${file}")
            message(FATAL_ERROR "Incomplete external MIGraphX/HIP SDK binary: ${file}")
        endif()
    endforeach()
    add_library(jyppx_external_migraphx_c SHARED IMPORTED GLOBAL)
    set_target_properties(jyppx_external_migraphx_c PROPERTIES
        IMPORTED_LOCATION "${mgx_runtime}" INTERFACE_INCLUDE_DIRECTORIES "${mgx}/include")
    add_library(jyppx_external_migraphx_hip SHARED IMPORTED GLOBAL)
    set_target_properties(jyppx_external_migraphx_hip PROPERTIES
        IMPORTED_LOCATION "${hip_runtime}" INTERFACE_INCLUDE_DIRECTORIES "${hip}/include"
        INTERFACE_COMPILE_DEFINITIONS "__HIP_PLATFORM_AMD__=1")
    if(WIN32)
        set_property(TARGET jyppx_external_migraphx_c PROPERTY IMPORTED_IMPLIB "${mgx_library}")
        set_property(TARGET jyppx_external_migraphx_hip PROPERTY IMPORTED_IMPLIB "${hip_library}")
    endif()
endfunction()
