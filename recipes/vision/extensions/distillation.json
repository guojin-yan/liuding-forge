    "distillation_temperature": 2.0,
    "logits_distillation_weight": 1.0,
    "feature_outputs": true,
    "feature_projection": 2048,
    "feature_distillation_weight": 1.0
  },
  "augmentation": {
    "horizontal_flip": 0.5
  },
  "full_validation_metrics": true,
  "selection_metric": "auto",
  "verify_image_contents": true
