{
  "schema_version": 2,
  "model": {
    "architecture": "resnet50",
    "task": "classify_multilabel",
    "variant": "p5",
    "num_classes": 3
  },
  "image_size": 224,
  "batch_size": 4,
  "workers": 0,
  "epochs": 100,
  "seed": 0,
  "device": "cpu",
  "precision": "full",
  "optimizer": {
    "name": "auto",
    "learning_rate": 0.001,
    "weight_decay": 0.0001
  },
  "extension": {
    "training_manifest": "dataset.train.json",
    "validation_manifest": "dataset.val.json"
  },
  "augmentation": {
    "horizontal_flip": 0
  },
  "full_validation_metrics": true,
  "selection_metric": "auto",
  "verify_image_contents": true,
  "classification_augmentation": {
    "brightness": 0.2,
    "contrast": 0.2,
    "saturation": 0.2,
    "erasing": 0.1
  }
}
