{
  "schema_version": 2,
  "model": {
    "architecture": "simmim_vit_tiny",
    "task": "pretrain_simmim",
    "variant": "p5",
    "num_classes": 3
  },
  "image_size": 224,
  "batch_size": 4,
  "workers": 0,
  "epochs": 100,
  "seed": 0,
  "device": "cpu",
  "precision": "full",
  "optimizer": {
    "name": "auto",
    "learning_rate": 0.001,
    "weight_decay": 0.0001
  },
  "extension": {
    "training_manifest": "dataset.train.json",
    "validation_manifest": "dataset.val.json",
    "model_patch_size": 16,
    "mask_patch_size": 32,
    "mask_ratio": 0.6,
    "activation_recomputation": true
  },
  "augmentation": {
    "horizontal_flip": 0.5
  },
  "full_validation_metrics": true,
  "selection_metric": "auto",
  "verify_image_contents": true,
  "ema": {
    "enabled": false
  }
}
