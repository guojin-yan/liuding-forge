{
  "schema_version": 1,
  "model": {
    "architecture": "faster_rcnn_resnet50_fpn",
    "task": "detect",
    "variant": "p5",
    "num_classes": 80
  },
  "image_size": 640,
  "batch_size": 4,
  "workers": 0,
  "epochs": 100,
  "seed": 0,
  "device": "cpu",
  "precision": "full",
  "optimizer": {
    "name": "sgd",
    "learning_rate": 0.005,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "nominal_batch": 64,
    "scale_weight_decay": false
  },
  "scheduler": {
    "warmup_updates": 10,
    "warmup_start_factor": 0.1,
    "final_factor": 0.01
  },
  "ema": {
    "enabled": true
  },
  "full_validation_metrics": true,
  "selection_metric": "auto",
  "early_stopping_patience": 30,
  "save_interval_epochs": 5,
  "verify_image_contents": true,
  "exif_policy": "reject",
  "dataset": {
    "format": "yolo",
    "source": "dataset.yaml"
  },
  "validation": {
    "format": "yolo",
    "source": "dataset.yaml",
    "split": "validation"
  },
  "augmentation": {
    "horizontal_flip": 0.5
  },
  "normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  }
}
