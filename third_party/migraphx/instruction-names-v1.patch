diff --git a/tools/api/api.cpp b/tools/api/api.cpp
--- a/tools/api/api.cpp
+++ b/tools/api/api.cpp
@@ -510,3 +510,30 @@
 } // namespace migraphx
 
 <% generate_c_api_body() %>
+
+// Liuding optional SDK extension v1; output ownership follows program_run.
+// Name storage is borrowed only for the duration of the callback.
+extern "C" MIGRAPHX_C_EXPORT migraphx_status migraphx_program_run_instruction_names_v1(
+    migraphx_arguments_t* out,
+    migraphx_program_t program,
+    migraphx_program_parameters_t params,
+    migraphx_status (*callback)(const char*, void*),
+    void* data)
+{
+    if(out == nullptr)
+        return migraphx_status_bad_param;
+    *out = nullptr;
+    return migraphx::try_([&] {
+        if(program == nullptr or params == nullptr or callback == nullptr)
+            MIGRAPHX_THROW(migraphx_status_bad_param, "Null instruction-name run parameter");
+        *out = allocate<migraphx_arguments_t>(program->object.eval_instruction_names(
+            params->object, [callback, data](migraphx::instruction_ref ins) {
+                std::ostringstream text;
+                text << ins->get_operator();
+                const auto name = text.str();
+                const auto status = callback(name.c_str(), data);
+                if(status != migraphx_status_success)
+                    MIGRAPHX_THROW(status, "Instruction-name callback returned an error");
+            }));
+    });
+}
diff --git a/tools/api/migraphx.h b/tools/api/migraphx.h
