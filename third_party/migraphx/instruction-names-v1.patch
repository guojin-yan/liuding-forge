From: Liuding Forge contributors
Subject: [PATCH] Add optional synchronized instruction-name C API v1

Base: AMDMIGraphX rocm-10.1 / 2.18.0. Original MIT notice is preserved
in each source file and third_party/licenses/migraphx-2.18.0-LICENSE.MIT.
The added code is provided under that same MIT license.

Add a method and C symbol without changing object layouts or existing APIs.
The same evaluator records actual inspectable instructions without copying
their intermediate tensors, finishes every context, and defers callback
errors until work completes. Existing tensor trace semantics are unchanged.

diff --git a/src/program.cpp b/src/program.cpp
--- a/src/program.cpp
+++ b/src/program.cpp
@@ -24,6 +24,7 @@
 #include <migraphx/version.h>
 #include <migraphx/compile_options.hpp>
 #include <migraphx/program.hpp>
+#include <exception>
 #include <migraphx/stringutils.hpp>
 #include <migraphx/instruction.hpp>
 #include <migraphx/scope_guard.hpp>
@@ -753,6 +754,32 @@
     }
 
     return ret;
+}
+
+std::vector<argument> program::eval_instruction_names(
+    const parameter_map& params,
+    const std::function<void(instruction_ref)>& callback) const
+{
+    if(not callback)
+        MIGRAPHX_THROW("Instruction-name callback is required");
+    auto& contexts = this->impl->contexts;
+    std::exception_ptr callback_error;
+    auto outputs = generic_eval(*this, contexts, params, [&](instruction_ref ins, auto f) {
+        auto result = f();
+        // Callback errors are deferred until all queued work has completed.
+        // This also keeps intermediates alive through the ordinary evaluation.
+        if(not callback_error and is_inspectable(ins->name()) and not result.empty())
+        {
+            try { callback(ins); }
+            catch(...) { callback_error = std::current_exception(); }
+        }
+        return result;
+    });
+    for(auto& ctx : contexts)
+        ctx.finish();
+    if(callback_error)
+        std::rethrow_exception(callback_error);
+    return outputs;
 }
 
 void program::finish() const
