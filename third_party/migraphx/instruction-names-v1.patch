+// Liuding optional SDK extension v1. Name storage is callback-scoped.
+// Callback errors are reported after completion; *out is null on failure.
+MIGRAPHX_C_EXPORT migraphx_status migraphx_program_run_instruction_names_v1(
+    migraphx_arguments_t* out,
+    migraphx_program_t program,
+    migraphx_program_parameters_t params,
+    migraphx_status (*callback)(const char*, void*),
+    void* data);
+
 #ifdef __cplusplus
 }
 #endif
